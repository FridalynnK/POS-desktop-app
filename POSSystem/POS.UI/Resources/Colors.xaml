<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ════════════════════════════════════════════════════════════
         POS SYSTEM — DESIGN TOKENS
         Usage: reference any key in any View e.g.
                Foreground="{StaticResource AccentGreen}"
    ═════════════════════════════════════════════════════════════ -->

    <!-- Backgrounds -->
    <SolidColorBrush x:Key="BgPage"       Color="#0F1117"/>
    <SolidColorBrush x:Key="BgTopBar"     Color="#13151F"/>
    <SolidColorBrush x:Key="BgCard"       Color="#1A1D27"/>
    <SolidColorBrush x:Key="BgRow"        Color="#22253A"/>
    <SolidColorBrush x:Key="BgDivider"    Color="#2A2D3E"/>

    <!-- Accent colours -->
    <SolidColorBrush x:Key="AccentBlue"   Color="#60A5FA"/>
    <SolidColorBrush x:Key="AccentGreen"  Color="#34D399"/>
    <SolidColorBrush x:Key="AccentAmber"  Color="#F59E0B"/>
    <SolidColorBrush x:Key="AccentPurple" Color="#A78BFA"/>
    <SolidColorBrush x:Key="AccentRed"    Color="#FF3B3B"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimary"  Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextMuted"    Color="#6B7280"/>
    <SolidColorBrush x:Key="TextSub"      Color="#9CA3AF"/>

    <!-- Raw colors (for use in DropShadowEffect, animations etc.
         where a SolidColorBrush won't work) -->
    <Color x:Key="ColorBgPage"       >#0F1117</Color>
    <Color x:Key="ColorAccentBlue"   >#60A5FA</Color>
    <Color x:Key="ColorAccentGreen"  >#34D399</Color>
    <Color x:Key="ColorAccentAmber"  >#F59E0B</Color>
    <Color x:Key="ColorAccentPurple" >#A78BFA</Color>
    <Color x:Key="ColorAccentRed"    >#FF3B3B</Color>

</ResourceDictionary>
