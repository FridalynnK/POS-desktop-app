<UserControl x:Class="POS.UI.Views.CashierView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{StaticResource BgPage}">

    <UserControl.Resources>

        <!-- Shared column header style -->
        <Style x:Key="ColHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background"      Value="{StaticResource BgTopBar}"/>
            <Setter Property="Foreground"      Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize"        Value="10"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="12,0"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BgDivider}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <!-- Shared row style -->
        <Style x:Key="DgRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource BgRow}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource BgRow}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Shared cell style -->
        <Style x:Key="DgCell" TargetType="DataGridCell">
            <Setter Property="Padding"           Value="12,0"/>
            <Setter Property="FontSize"          Value="13"/>
            <Setter Property="BorderThickness"   Value="0"/>
            <Setter Property="Foreground"        Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background"        Value="Transparent"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Action button -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height"          Value="34"/>
            <Setter Property="Padding"         Value="16,0"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Foreground"      Value="White"/>
        </Style>

        <!-- Section header label -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ LEFT — Products ═══════════════════════════════════ -->
        <Border Grid.Column="0" Grid.Row="0"
                Margin="24,24,12,12"
                CornerRadius="12"
                Background="{StaticResource BgCard}">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.35"
                                  BlurRadius="14" ShadowDepth="2"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Panel header -->
                <Border Grid.Row="0"
                        BorderBrush="{StaticResource BgDivider}"
                        BorderThickness="0,0,0,1"
                        Padding="16,12">
                    <TextBlock Text="📦  PRODUCTS"
                               Style="{StaticResource SectionHeader}"/>
                </Border>

                <!-- Search box -->
                <Border Grid.Row="1" Padding="12,10"
                        BorderBrush="{StaticResource BgDivider}"
                        BorderThickness="0,0,0,1">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Height="32"
                             Background="{StaticResource BgRow}"
                             Foreground="{StaticResource TextPrimary}"
                             CaretBrush="{StaticResource TextPrimary}"
                             BorderBrush="{StaticResource BgDivider}"
                             BorderThickness="1"
                             VerticalContentAlignment="Center"
                             Padding="10,0"
                             FontSize="13">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <VisualBrush Stretch="None" AlignmentX="Left">
                                                    <VisualBrush.Visual>
                                                        <TextBlock Text="🔍  Search by name or SKU..."
                                                                   Foreground="{StaticResource TextMuted}"
                                                                   Margin="10,0,0,0"
                                                                   FontSize="13"
                                                                   VerticalAlignment="Center"/>
                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </Border>

                <!-- Product DataGrid -->
                <DataGrid Grid.Row="2"
                          ItemsSource="{Binding Products}"
                          SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          CanUserAddRows="False"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{StaticResource BgDivider}"
                          Background="Transparent"
                          BorderThickness="0"
                          RowHeight="36"
                          ColumnHeaderHeight="34"
                          ColumnHeaderStyle="{StaticResource ColHeader}"
                          RowStyle="{StaticResource DgRow}"
                          CellStyle="{StaticResource DgCell}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="SKU"   Binding="{Binding SKU}"                                    Width="80"/>
                        <DataGridTextColumn Header="NAME"  Binding="{Binding Name}"                                   Width="*"/>
                        <DataGridTextColumn Header="PRICE" Binding="{Binding SellingPrice, StringFormat='XAF {0:N0}'}" Width="110"/>
                        <DataGridTextColumn Header="STOCK" Binding="{Binding Quantity}"                               Width="60"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Add to Cart -->
                <Border Grid.Row="3"
                        Padding="12,10"
                        BorderBrush="{StaticResource BgDivider}"
                        BorderThickness="0,1,0,0">
                    <Button Content="➕  Add to Cart"
                            Style="{StaticResource ActionBtn}"
                            Background="{StaticResource AccentBlue}"
                            Foreground="{StaticResource BgPage}"
                            HorizontalAlignment="Stretch"
                            Command="{Binding AddToCartCommand}"/>
                </Border>
            </Grid>
        </Border>

        <!-- ═══ RIGHT — Cart ══════════════════════════════════════ -->
        <Border Grid.Column="1" Grid.Row="0"
                Margin="12,24,24,12"
                CornerRadius="12"
                Background="{StaticResource BgCard}">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.35"
                                  BlurRadius="14" ShadowDepth="2"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Panel header -->
                <Border Grid.Row="0"
                        BorderBrush="{StaticResource BgDivider}"
                        BorderThickness="0,0,0,1"
                        Padding="16,12">
                    <TextBlock Text="🛒  CART"
                               Style="{StaticResource SectionHeader}"/>
                </Border>

                <!-- Cart DataGrid -->
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding CartItems}"
                          SelectedItem="{Binding SelectedCartItem, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          CanUserAddRows="False"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{StaticResource BgDivider}"
                          Background="Transparent"
                          BorderThickness="0"
                          RowHeight="36"
                          ColumnHeaderHeight="34"
                          ColumnHeaderStyle="{StaticResource ColHeader}"
                          RowStyle="{StaticResource DgRow}"
                          CellStyle="{StaticResource DgCell}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="PRODUCT"    Binding="{Binding Name}"                                   Width="*"/>
                        <DataGridTextColumn Header="QTY"        Binding="{Binding Quantity}"                               Width="60"/>
                        <DataGridTextColumn Header="UNIT PRICE" Binding="{Binding UnitPrice, StringFormat='XAF {0:N0}'}"   Width="120"/>
                        <DataGridTextColumn Header="TOTAL"      Binding="{Binding LineTotal, StringFormat='XAF {0:N0}'}"   Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Remove / Clear buttons -->
                <Border Grid.Row="2"
                        Padding="12,10"
                        BorderBrush="{StaticResource BgDivider}"
                        BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="🗑  Remove Item"
                                Style="{StaticResource ActionBtn}"
                                Background="{StaticResource AccentRed}"
                                Margin="0,0,8,0"
                                Command="{Binding RemoveFromCartCommand}"/>
                        <Button Content="✖  Clear Cart"
                                Style="{StaticResource ActionBtn}"
                                Background="{StaticResource BgRow}"
                                Command="{Binding ClearCartCommand}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ═══ BOTTOM — Payment bar ══════════════════════════════ -->
        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                Margin="24,0,24,24"
                CornerRadius="12"
                Background="{StaticResource BgCard}"
                Padding="20,14">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.35"
                                  BlurRadius="14" ShadowDepth="2"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Payment method -->
                <TextBlock Grid.Column="0"
                           Text="PAYMENT"
                           FontSize="10" FontWeight="SemiBold"
                           Foreground="{StaticResource TextMuted}"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>
                <ComboBox Grid.Column="1"
          ItemsSource="{Binding PaymentMethods}"
          SelectedItem="{Binding SelectedPaymentMethod}"
          Width="130" Height="34"
          Margin="0,0,20,0"
          FontSize="13"
          Background="{StaticResource BgRow}"
          Foreground="{StaticResource TextPrimary}"
          BorderBrush="{StaticResource BgDivider}">

                    <!-- ↓ These two blocks fix the white-on-white dropdown -->
                    <ComboBox.Resources>
                        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}"
                         Color="#22253A"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"
                         Color="#2A2D3E"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"
                         Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}"
                         Color="#FFFFFF"/>
                    </ComboBox.Resources>

                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Background" Value="#22253A"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            <Setter Property="Padding"    Value="10,6"/>
                            <Setter Property="FontSize"   Value="13"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource BgDivider}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource BgDivider}"/>
                                    <Setter Property="Foreground" Value="{StaticResource AccentBlue}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.ItemContainerStyle>

                </ComboBox>

                <!-- Cash entered -->
                <TextBlock Grid.Column="2"
                           Text="CASH"
                           FontSize="10" FontWeight="SemiBold"
                           Foreground="{StaticResource TextMuted}"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCashPayment}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBox Grid.Column="3"
                         Text="{Binding CashAmountEntered, UpdateSourceTrigger=PropertyChanged}"
                         Width="120" Height="34"
                         Margin="0,0,20,0"
                         Background="{StaticResource BgRow}"
                         Foreground="{StaticResource TextPrimary}"
                         CaretBrush="{StaticResource TextPrimary}"
                         BorderBrush="{StaticResource BgDivider}"
                         VerticalContentAlignment="Center"
                         Padding="10,0" FontSize="13">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCashPayment}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <!-- Change due -->
                <StackPanel Grid.Column="4"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,24,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowChangeDue}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="CHANGE  "
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource TextMuted}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ChangeDue, StringFormat='XAF {0:N0}'}"
                               FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource AccentGreen}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Grand Total -->
                <StackPanel Grid.Column="5"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,20,0">
                    <TextBlock Text="TOTAL  "
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource TextMuted}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding GrandTotal, StringFormat='XAF {0:N0}'}"
                               FontSize="24" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimary}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Complete Sale -->
                <Button Grid.Column="6"
                        Content="✔  Complete Sale"
                        Height="40" Padding="20,0"
                        FontSize="13" FontWeight="SemiBold"
                        Background="{StaticResource AccentGreen}"
                        Foreground="{StaticResource BgPage}"
                        BorderThickness="0" Cursor="Hand"
                        Command="{Binding CompleteSaleCommand}"/>
            </Grid>
        </Border>

    </Grid>
</UserControl>
