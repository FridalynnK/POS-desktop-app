<UserControl x:Class="POS.UI.Views.ProductView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{StaticResource BgPage}">

    <UserControl.Resources>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height"          Value="34"/>
            <Setter Property="Padding"         Value="16,0"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Foreground"      Value="White"/>
        </Style>

        <Style x:Key="HeaderLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ TOOLBAR ══════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{StaticResource BgTopBar}"
                BorderBrush="{StaticResource BgDivider}"
                BorderThickness="0,0,0,1"
                Padding="24,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                <Button Content="➕  Add"
                        Style="{StaticResource ActionBtn}"
                        Background="{StaticResource AccentBlue}"
                        Foreground="{StaticResource BgPage}"
                        Margin="0,0,8,0"
                        Command="{Binding AddCommand}"/>

                <Button Content="✏  Modify"
                        Style="{StaticResource ActionBtn}"
                        Background="{StaticResource AccentAmber}"
                        Foreground="{StaticResource BgPage}"
                        Margin="0,0,8,0"
                        Command="{Binding ModifyCommand}"/>

                <Button Content="🗑  Delete"
                        Style="{StaticResource ActionBtn}"
                        Background="{StaticResource AccentRed}"
                        Margin="0,0,8,0"
                        Command="{Binding DeleteCommand}"/>

                <Button Content="💾  Save"
                        Style="{StaticResource ActionBtn}"
                        Background="{StaticResource AccentGreen}"
                        Foreground="{StaticResource BgPage}"
                        Command="{Binding SaveCommand}"/>

            </StackPanel>
        </Border>

        <!-- ══ TABLE ════════════════════════════════════════════════ -->
        <Border Grid.Row="1" Margin="24" CornerRadius="12"
                Background="{StaticResource BgCard}">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.35"
                                  BlurRadius="14" ShadowDepth="2"/>
            </Border.Effect>

            <DataGrid ItemsSource="{Binding Products}"
                      SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      IsReadOnly="{Binding IsReadOnlyMode}"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      GridLinesVisibility="Horizontal"
                      Background="Transparent"
                      BorderThickness="0"
                      RowHeight="38"
                      ColumnHeaderHeight="36">

                <!-- Header style -->
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background"      Value="{StaticResource BgTopBar}"/>
                        <Setter Property="Foreground"      Value="{StaticResource TextMuted}"/>
                        <Setter Property="FontSize"        Value="10"/>
                        <Setter Property="FontWeight"      Value="SemiBold"/>
                        <Setter Property="Padding"         Value="12,0"/>
                        <Setter Property="BorderBrush"     Value="{StaticResource BgDivider}"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <!-- Row style -->
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource BgRow}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource BgRow}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <!-- Cell style -->
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding"          Value="12,0"/>
                        <Setter Property="FontSize"         Value="13"/>
                        <Setter Property="BorderThickness"  Value="0"/>
                        <Setter Property="Foreground"       Value="{StaticResource TextPrimary}"/>
                        <Setter Property="Background"       Value="Transparent"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID"            Binding="{Binding Id}"                                      IsReadOnly="True" Width="50"/>
                    <DataGridTextColumn Header="SKU"           Binding="{Binding SKU}"                                                       Width="100"/>
                    <DataGridTextColumn Header="NAME"          Binding="{Binding Name}"                                                      Width="160"/>
                    <DataGridTextColumn Header="CATEGORY"      Binding="{Binding Category}"                                                  Width="120"/>
                    <DataGridTextColumn Header="BUYING PRICE"  Binding="{Binding BuyingPrice,  StringFormat='XAF {0:N0}'}"                   Width="120"/>
                    <DataGridTextColumn Header="SELLING PRICE" Binding="{Binding SellingPrice, StringFormat='XAF {0:N0}'}"                   Width="120"/>
                    <DataGridTextColumn Header="QTY"           Binding="{Binding Quantity}"                                                  Width="60"/>
                    <DataGridTextColumn Header="REORDER"       Binding="{Binding ReorderLevel}"                                              Width="70"/>
                    <DataGridTextColumn Header="EXPIRY"        Binding="{Binding ExpiryDate,   StringFormat=d}"                              Width="100"/>
                    <DataGridTextColumn Header="ADDED"         Binding="{Binding AddedDate,    StringFormat=d}"            IsReadOnly="True" Width="100"/>
                    <DataGridCheckBoxColumn Header="ACTIVE"    Binding="{Binding IsActive}"                                                  Width="60"/>
                </DataGrid.Columns>

            </DataGrid>
        </Border>
    </Grid>
</UserControl>
