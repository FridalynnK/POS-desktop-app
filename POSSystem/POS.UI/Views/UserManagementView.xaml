<UserControl x:Class="POS.UI.Views.UserManagementView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{StaticResource BgPage}">

    <UserControl.Resources>

        <Style x:Key="ColHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background"      Value="{StaticResource BgTopBar}"/>
            <Setter Property="Foreground"      Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize"        Value="10"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="12,0"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BgDivider}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style x:Key="DgRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource BgRow}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource BgRow}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DgCell" TargetType="DataGridCell">
            <Setter Property="Padding"           Value="12,0"/>
            <Setter Property="FontSize"          Value="13"/>
            <Setter Property="BorderThickness"   Value="0"/>
            <Setter Property="Foreground"        Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background"        Value="Transparent"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="Margin"     Value="0,0,0,4"/>
        </Style>

        <Style x:Key="FormInput" TargetType="TextBox">
            <Setter Property="Height"           Value="34"/>
            <Setter Property="Padding"          Value="10,0"/>
            <Setter Property="FontSize"         Value="13"/>
            <Setter Property="Background"       Value="{StaticResource BgRow}"/>
            <Setter Property="Foreground"       Value="{StaticResource TextPrimary}"/>
            <Setter Property="CaretBrush"       Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush"      Value="{StaticResource BgDivider}"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin"           Value="0,0,0,14"/>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height"          Value="34"/>
            <Setter Property="Padding"         Value="16,0"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>       <!-- User list -->
            <ColumnDefinition Width="300"/>     <!-- Form panel -->
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ TOOLBAR ══════════════════════════════════════════════ -->
        <Border Grid.Row="0" Grid.ColumnSpan="2"
                Background="{StaticResource BgTopBar}"
                BorderBrush="{StaticResource BgDivider}"
                BorderThickness="0,0,0,1"
                Padding="24,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="👤  USER MANAGEMENT"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}"
                           VerticalAlignment="Center"
                           Margin="0,0,24,0"/>
                <Button Content="➕  New User"
                        Style="{StaticResource ActionBtn}"
                        Background="{StaticResource AccentBlue}"
                        Foreground="{StaticResource BgPage}"
                        Command="{Binding NewCommand}"/>
            </StackPanel>
        </Border>

        <!-- ══ USER TABLE ═══════════════════════════════════════════ -->
        <Border Grid.Row="1" Grid.Column="0"
                Margin="24,24,12,24"
                CornerRadius="12"
                Background="{StaticResource BgCard}">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.35"
                                  BlurRadius="14" ShadowDepth="2"/>
            </Border.Effect>

            <DataGrid ItemsSource="{Binding Users}"
                      SelectedItem="{Binding SelectedUser, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{StaticResource BgDivider}"
                      Background="Transparent"
                      BorderThickness="0"
                      RowHeight="40"
                      ColumnHeaderHeight="36"
                      ColumnHeaderStyle="{StaticResource ColHeader}"
                      RowStyle="{StaticResource DgRow}"
                      CellStyle="{StaticResource DgCell}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID"
                                        Binding="{Binding Id}"
                                        Width="50"/>
                    <DataGridTextColumn Header="USERNAME"
                                        Binding="{Binding Username}"
                                        Width="150"/>
                    <DataGridTextColumn Header="DISPLAY NAME"
                                        Binding="{Binding DisplayName}"
                                        Width="*"/>
                    <DataGridTextColumn Header="ROLE"
                                        Binding="{Binding Role}"
                                        Width="100"/>
                    <DataGridCheckBoxColumn Header="ACTIVE"
                                            Binding="{Binding IsActive}"
                                            Width="70"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ══ FORM PANEL ═══════════════════════════════════════════ -->
        <Border Grid.Row="1" Grid.Column="1"
                Margin="12,24,24,24"
                CornerRadius="12"
                Background="{StaticResource BgCard}">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.35"
                                  BlurRadius="14" ShadowDepth="2"/>
            </Border.Effect>

            <DockPanel>

                <!-- Form header -->
                <Border DockPanel.Dock="Top"
                        BorderBrush="{StaticResource BgDivider}"
                        BorderThickness="0,0,0,1"
                        Padding="16,12">
                    <TextBlock Text="{Binding FormTitle}"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource TextMuted}"/>
                </Border>

                <!-- Status message -->
                <Border DockPanel.Dock="Bottom"
                        Padding="16,10"
                        BorderBrush="{StaticResource BgDivider}"
                        BorderThickness="0,1,0,0">
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="12" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource AccentGreen}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource AccentRed}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <!-- Form fields -->
                <ScrollViewer Padding="16,16" VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!-- Username -->
                        <TextBlock Text="USERNAME" Style="{StaticResource FormLabel}"/>
                        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormInput}"/>

                        <!-- Display Name -->
                        <TextBlock Text="DISPLAY NAME" Style="{StaticResource FormLabel}"/>
                        <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormInput}"/>

                        <!-- Password (shown for new users; also used for change password) -->
                        <TextBlock Style="{StaticResource FormLabel}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock"
                                       BasedOn="{StaticResource FormLabel}">
                                    <Setter Property="Text" Value="PASSWORD"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                            <Setter Property="Text" Value="NEW PASSWORD (optional)"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormInput}"/>

                        <!-- Role -->
                        <TextBlock Text="ROLE" Style="{StaticResource FormLabel}"/>
                        <ComboBox ItemsSource="{Binding Roles}"
                                  SelectedItem="{Binding Role}"
                                  Height="34" Margin="0,0,0,14"
                                  FontSize="13"
                                  Background="{StaticResource BgRow}"
                                  Foreground="{StaticResource TextPrimary}"
                                  BorderBrush="{StaticResource BgDivider}">
                            <ComboBox.Resources>
                                <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}"     Color="#22253A"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"  Color="#2A2D3E"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#FFFFFF"/>
                            </ComboBox.Resources>
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="Background" Value="#22253A"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                    <Setter Property="Padding"    Value="10,6"/>
                                    <Setter Property="FontSize"   Value="13"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource BgDivider}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{StaticResource BgDivider}"/>
                                            <Setter Property="Foreground" Value="{StaticResource AccentBlue}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.ItemContainerStyle>
                        </ComboBox>

                        <!-- Active toggle (edit only) -->
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,20"
                                    Visibility="{Binding IsEditing,
                                                 Converter={StaticResource BoolToVis}}">
                            <CheckBox IsChecked="{Binding IsActive}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,8,0"/>
                            <TextBlock Text="Account Active"
                                       FontSize="13"
                                       Foreground="{StaticResource TextPrimary}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Action buttons -->
                        <Button Content="💾  Save"
                                Style="{StaticResource ActionBtn}"
                                Background="{StaticResource AccentGreen}"
                                Foreground="{StaticResource BgPage}"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,0,8"
                                Command="{Binding SaveCommand}"/>

                        <Button Content="🔑  Change Password"
                                Style="{StaticResource ActionBtn}"
                                Background="{StaticResource AccentAmber}"
                                Foreground="{StaticResource BgPage}"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,0,8"
                                Visibility="{Binding IsEditing,
                                             Converter={StaticResource BoolToVis}}"
                                Command="{Binding ChangePasswordCommand}"/>

                        <Button Content="🗑  Delete User"
                                Style="{StaticResource ActionBtn}"
                                Background="{StaticResource AccentRed}"
                                Foreground="White"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,0,8"
                                Visibility="{Binding IsEditing,
                                             Converter={StaticResource BoolToVis}}"
                                Command="{Binding DeleteCommand}"/>

                        <Button Content="✖  Cancel"
                                Style="{StaticResource ActionBtn}"
                                Background="{StaticResource BgRow}"
                                Foreground="{StaticResource TextMuted}"
                                HorizontalAlignment="Stretch"
                                Command="{Binding CancelCommand}"/>

                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
